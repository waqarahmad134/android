# Copy to .env and fill in ONLY when you are ready for LIVE trading.
# Paper mode (the default) does not require any keys.
#
# SECURITY:
#  - Create API keys with TRADE permission only.
#  - NEVER enable WITHDRAWAL permission on a bot key.
#  - Restrict keys by IP where the exchange allows it.

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- KuCoin (requires a passphrase) ---
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSWORD=

# --- Bybit ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Slack alerts (optional) ---
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
# Works reliably worldwide and won't miss alerts. Then set notifications.enabled
# to true in config/config.yaml.
SLACK_WEBHOOK_URL=
